# Copy this file to .env and fill in your own values.
# Never commit .env, and never put real keys in source files.
# Paper keys: https://app.alpaca.markets/paper/dashboard/overview

ALPACA_API_KEY_ID=your_paper_key_id
ALPACA_API_SECRET_KEY=your_paper_secret_key

# Paper trading is the default. Live trading also requires
# MarketClient(allow_live=True) in code. Leave this false unless you mean it.
ALPACA_LIVE=false

# basic: IEX real-time, SIP history older than 15 minutes.
# sip: Algo Trader Plus (full SIP feed).
ALPACA_DATA_PLAN=basic

# indicative: free options feed. opra: OPRA subscription.
ALPACA_OPTIONS_FEED=indicative

# Stay under Alpaca's 200 requests/minute free-plan limit.
ALPACA_RPM=190
ALPACA_TIMEOUT=15
ALPACA_MAX_RETRIES=4

# Expose POST /orders on the local HTTP service.
# Requests still default to dry_run, and the service never trades live.
ALPACA_HTTP_ENABLE_ORDERS=false
